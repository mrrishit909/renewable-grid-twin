 "components": {
  "schemas": {
   "ContIn": {
    "properties": {
     "step": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 95.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Step"
     },
     "top": {
      "type": "integer",
      "maximum": 50.0,
      "minimum": 1.0,
      "title": "Top",
      "default": 10
     }
    },
    "type": "object",
    "title": "ContIn"
   },
   "DispatchIn": {
    "properties": {
     "use_batteries": {
      "type": "boolean",
      "title": "Use Batteries",
      "default": true
     },
     "activate": {
      "type": "boolean",
      "title": "Activate",
      "default": true
     }
    },
    "type": "object",
    "title": "DispatchIn"
   },
   "FcIn": {
    "properties": {
     "store": {
      "type": "boolean",
      "title": "Store",
      "default": true
     }
    },
    "type": "object",
    "title": "FcIn"
   },
   "FlowIn": {
    "properties": {
     "step": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 95.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Step",
      "description": "15-minute step of the day; past steps use telemetry, future ones the latest forecast"
     },
     "extra_lines_out": {
      "items": {
       "type": "integer"
      },
      "type": "array",
      "maxItems": 5,
      "title": "Extra Lines Out"
     }
    },
    "type": "object",
    "title": "FlowIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LineStatusIn": {
    "properties": {
     "status": {
      "type": "string",
      "pattern": "^(out|in service)$",
      "title": "Status"
     },
     "reason": {
      "type": "string",
      "maxLength": 200,
      "minLength": 3,
      "title": "Reason"
     }
    },
    "type": "object",
    "required": [
     "status",
     "reason"
    ],
    "title": "LineStatusIn"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 17
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "PollIn": {
    "properties": {
     "steps": {
      "type": "integer",
      "maximum": 56.0,
      "minimum": 1.0,
      "title": "Steps"
     }
    },
    "type": "object",
    "required": [
     "steps"
    ],
    "title": "PollIn"
   },
   "Reading": {
    "properties": {
     "asset": {
      "type": "string",
      "maxLength": 40,
      "title": "Asset",
      "description": "asset name, e.g. 'Solar 3'"
     },
     "ts": {
      "type": "string",
      "format": "date-time",
      "title": "Ts"
     },
